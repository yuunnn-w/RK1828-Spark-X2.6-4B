# /etc/rk1828-spark.env — rk1828-spark.service 的配置（由 start.sh 读取）
# 全部可选；不写就用 start.sh 里的默认值。改完执行：systemctl restart rk1828-spark.service

# ---- 模型 ----
PREFIX=/opt/rk1828-spark
MODEL_DIR=/opt/rk1828-spark/model
MODEL_NAME=Spark-X2.6-4B-73728-kvi4      # 目录里的 .rknn/.weight 前缀（不含后缀）
BASE_NAME=Spark-X2.6-4B                  # .tokenizer.gguf / .embed.bin 的前缀（多变体共用）
CTX=73728                                # 必须与转换时的 max_context_len 一致
CORE_MASK=0xff                           # 8 核全用

# ---- 服务 ----
HOST=0.0.0.0
PORT=8080
ALIAS=Spark-X2.6-4B
MAX_CONNS=128
MAX_QUEUE=64                # 排队深度，超过返回 429 + Retry-After
REQ_TIMEOUT=1200            # 单次生成墙钟上限（秒）
# API_KEY=change-me         # 打开后客户端须带 Authorization: Bearer <key>

# ---- 采样（默认取自模型厂商 XHToken/Spark-X2.6-4B 的 generation_config.json）----
# 注意：这与 rkllm3-server --help 的默认（temp 0.8 / top_k 1 / top_p 0.9）不是一回事。
# 本项目用途是长上下文 Agent 与编码，因此刻意不加任何重复惩罚。
THINKING=on
TEMP=1.0
TOP_K=0                    # 0 = 不截断（官方 top_k=-1）；要真正的随机采样需调大（例如 40）
TOP_P=0.95
REPEAT_PENALTY=1.0         # 1.0 = 关闭
FREQ_PENALTY=0.0
PRESENCE_PENALTY=0.0
MAX_NEW=0                  # 0 = 输出长度不限制（生成到 EOS 或上下文用完）
MAX_NEW_CAP=0              # 0 = 不给客户端的 max_tokens 设天花板
EFFORT_INJECT=on           # off = 不往 system 里注入官方那句 thinking_effort 文本
# EFFORT=low               # 可选：服务端默认思考档位（high|low|none|minimal）。
                           # 实测留出集上 low 比 high 高约 4 个百分点且输出短 20% 左右；
                           # 不设置就跟官方模板一致用 high。客户端传 reasoning_effort 会覆盖它。

# ---- 其它参数（任意 CLI 参数都可从这里追加）----
# 思考/答案分离（DeepSeek 风格）：非流式给 message.reasoning_content + message.content，流式给 delta.reasoning_content
EXTRA_ARGS="--reasoning-format deepseek"
# 关掉全部三层复读熔断（只靠 EOS / 上下文窗口 / 墙钟超时收尾）：
# EXTRA_ARGS="--reasoning-format deepseek --fuse-off"
# 退回 runtime 内置采样（无熔断）：
# EXTRA_ARGS="--sampler runtime"
